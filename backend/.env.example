PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wallet_db?schema=public"
JWT_SECRET="super-secret-crypto-jwt-key-2026"
WEBHOOK_SECRET_KEY="whsec_prod_super_secret_signing_key_2026"

# Let'sBit Corporate B2B (API de Rampa ARS y Liquidez Cripto)
LETSBIT_API_KEY=""
LETSBIT_API_SECRET=""
LETSBIT_ENVIRONMENT="sandbox" # Cambiar a "production" al salir en vivo
LETSBIT_WEBHOOK_SECRET="whsec_prod_super_secret_signing_key_2026"

# Margen de comisión en swaps (1.0 = 1%)
DEFAULT_SPREAD_PERCENTAGE=1.0

# Duración de la cotización en segundos antes de expirar
QUOTE_TTL_SECONDS=30
